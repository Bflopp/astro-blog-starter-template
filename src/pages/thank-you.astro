---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title="Thank You | Bflopp" description="Freight cost review received" />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        overflow-x: hidden;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        background: white;
        color: rgb(30, 30, 30);
        line-height: 1.6;
      }

      main {
        max-width: 720px;
        width: 100%;
        margin: 2rem auto;
        padding: 1.25rem;
        text-align: center;
      }

      h1 {
        margin-bottom: 0.75rem;
        font-size: 1.6rem;
      }

      p {
        font-size: 1.05rem;
        margin-bottom: 1.5rem;
      }

      .button {
        display: inline-block;
        padding: 0.75em 1.5em;
        background: #007acc;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .button:hover {
        background: #005fa3;
      }

      /* =========================
         MOBILE FIX (iPhone-safe)
      ========================== */

      @media (max-width: 480px) {
        main {
          margin: 1.5rem 0.75rem;
          padding: 1rem;
        }

        h1 {
          font-size: 1.4rem;
        }

        p {
          font-size: 1rem;
        }

        .button {
          width: 100%;
          display: block;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <h1>Request Received ✅</h1>

      <p>
        Thanks — your freight cost review request has been submitted.
        We’ll analyze your shipping profile and follow up if there are meaningful savings opportunities.
      </p>

      <p>
        Most companies discover they are overpaying 8–22% on full truckload freight.
      </p>

      <a class="button" href="/">Return to Home</a>
    </main>

    <Footer />
  </body>
</html>