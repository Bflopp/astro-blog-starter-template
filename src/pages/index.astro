---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello and Welcome to Bflopp!</h1>
			<p>
				Welcome to Bflopp! This website is intended to help people get what they need.
			</p>
		
			<p>Bflopp wants to connect shippers to shipping brokers and we do it a simple way</p>
			<ul>
				<li>Fill out a no cost form</li>
				<li>Bflopp gives that information to companies competing to earn you business</li>
				<li>If a company feels like they can help[, they reach out</li>
				<li>from there, you work together</li>
				<li>a simple idea - connecting people to work together</li>
			</ul>
			
			<p>
				If you are looking to build a website of your own I would suggest taking a look at this template , Bflopp chose it because we think it looks nice <a
					href="https://github.com/Charca/astro-blog-template"
					>astro-blog-template
				</a> by <a href="https://twitter.com/Charca">Maxi Ferreira</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
