---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello and Welcome to Bflopp!</h1>
		
			<p>Bflopp wants to connect shippers to shipping brokers and we do it a simple way</p>
			<ul>
				<li>you fill out a no cost shipping <a href="/shipping" target="_self">form</a> </li>
    <li>We help connect shippers with brokers through our </li>
				<li>Bflopp gives that information to a company competing to earn your business</li>
				<li>if a company feels like they can help, they reach out to you</li>
				<li>from there -> you work together and Bflopp did its purpose</li>
				<li>it is a simple idea - connect people so they can work together</li>

			</ul>
			
		</main>
		<Footer />
	</body>
</html>
