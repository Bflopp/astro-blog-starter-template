---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        max-width: 100%;
        overflow-x: hidden; /* 🔥 HARD STOP overflow */
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        background: #f9fafb;
        color: #333;
        line-height: 1.6;
      }

      main {
        width: 100%;
        max-width: 720px;
        margin: 2rem auto;
        padding: 1rem;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);

        /* 🔥 prevents flex children from escaping */
        overflow-x: hidden;
      }

      h1 {
        text-align: center;
        font-size: 1.4rem;
        margin-bottom: 0.75rem;
      }

      h2, h3 {
        margin-top: 1.5rem;
      }

      p.lead {
        text-align: center;
        color: #6b7280;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
        max-width: 100%;
      }

      input, textarea {
        width: 100%;
        max-width: 100%;
        padding: 0.8rem 1rem;
        border: 1.5px solid #d1d5db;
        border-radius: 8px;
        font-size: 16px;
      }

      textarea {
        min-height: 100px;
      }

      button {
        width: 180px;
        align-self: center;
        padding: 0.75rem 1rem;
        border: none;
        background: #2563eb;
        color: white;
        font-weight: 700;
        border-radius: 10px;
      }

      /* =========================
         TAP CARD FIX (CRITICAL)
      ========================== */

      .card-group {
        display: grid;
        gap: 0.75rem;
        width: 100%;
        max-width: 100%;
      }

      .card-option {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;

        border: 1.5px solid #d1d5db;
        border-radius: 12px;
        padding: 0.9rem 1rem;
        background: #fff;
        cursor: pointer;

        width: 100%;
        max-width: 100%;

        /* 🔥 CRITICAL FIX */
        min-width: 0;
        overflow: hidden;
      }

      .card-option input {
        flex-shrink: 0;
        margin-top: 0.2rem;
        transform: scale(1.2);
      }

      .card-option span {
        display: block;

        /* 🔥 CRITICAL FIX (THIS IS WHAT WAS BREAKING iPHONE) */
        min-width: 0;
        max-width: 100%;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        line-height: 1.3;
      }

      .card-option:has(input:checked) {
        border-color: #2563eb;
        background: #eff6ff;
      }

      @media (max-width: 480px) {
        main {
          margin: 1rem 0.75rem;
        }

        button {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <h1>Shipping Information Form</h1>

      <h2>🚛 Freight Connection Request</h2>

      <p class="lead">
        Bflopp connects shippers with freight brokers based on operational needs and routing patterns.
      </p>

      <form id="shipping-form">

        <input type="hidden" name="lead_source" value="Website - Shipping Page" />
        <input type="hidden" name="lead_type" value="broker_match_request" />

        <h3>Company Information</h3>

        <input type="text" name="company" placeholder="Company Name" required />
        <input type="text" name="contact" placeholder="Contact Name" required />
        <input type="email" name="email" placeholder="Email" required />
        <input type="text" name="industry" placeholder="Industry" />

        <h3>Company Size</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="company_size" value="1–50 employees" required />
            <span>1–50 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="50–200 employees" />
            <span>50–200 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="200–500 employees" />
            <span>200–500 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="500+ employees" />
            <span>500+ employees</span>
          </label>
        </div>

        <h3>Urgency</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="urgency" value="Immediate (0–7 days)" required />
            <span>⚡ Immediate (0–7 days)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="urgency" value="Short-term (1–4 weeks)" />
            <span>📦 Short-term (1–4 weeks)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="urgency" value="Ongoing / Planning" />
            <span>📅 Ongoing / Planning</span>
          </label>
        </div>

        <h3>Equipment Needs</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="checkbox" name="equipment" value="Dry Van" />
            <span>Dry Van</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Reefer" />
            <span>Reefer</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Flatbed" />
            <span>Flatbed</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Specialized / Other" />
            <span>Specialized / Other</span>
          </label>
        </div>

        <h3>Routes</h3>
        <textarea name="lanes"></textarea>

        <h3>Notes</h3>
        <textarea name="challenge"></textarea>

        <label>
          <input type="checkbox" name="audit_interest" required />
          Request freight matching assistance
        </label>

        <button type="submit">Request Review</button>
      </form>

      <script>
        const form = document.getElementById("shipping-form");

        form.addEventListener("submit", async function (e) {
          e.preventDefault();

          const formData = new FormData(form);

          try {
            await fetch("https://formspree.io/f/maqvnaja", {
              method: "POST",
              body: formData,
              headers: { Accept: "application/json" }
            });
          } catch (err) {}

          window.location.href = "https://bflopp.com/thank-you";
        });
      </script>

    </main>

    <Footer />
  </body>
</html>