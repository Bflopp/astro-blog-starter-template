---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        overflow-x: hidden;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        background: #f9fafb;
        color: #111; /* 🔥 strong default contrast */
      }

      main {
        max-width: 720px;
        margin: 2rem auto;
        padding: 1rem;
        background: white;
        border-radius: 12px;
        overflow-x: hidden;
      }

      h1 {
        font-size: 1.35rem;
        text-align: center;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
      }

      input, textarea {
        width: 100%;
        padding: 0.8rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 16px;
      }

      textarea {
        min-height: 90px;
      }

      button {
        width: 100%;
        padding: 0.9rem;
        background: #2563eb;
        color: white;
        font-weight: 700;
        border-radius: 10px;
        border: none;
      }

      /* =========================
         CARD FIX (SAFE VERSION)
      ========================== */

      .card-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .card-option {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        padding: 0.9rem 1rem;
        border: 1.5px solid #d1d5db;
        border-radius: 12px;
        background: #fff;

        cursor: pointer;

        width: 100%;
      }

      .card-option input {
        flex-shrink: 0;
        transform: scale(1.15);
      }

      /* 🔥 THIS IS THE FIX FOR YOUR "BLANK TEXT" ISSUE */
      .card-option span {
        display: block !important;
        color: #111827 !important;   /* FORCE VISIBILITY */
        opacity: 1 !important;       /* SAFARI FIX */
        font-size: 1rem;
        line-height: 1.3;
        white-space: normal;
      }

      .card-option:has(input:checked) {
        border-color: #2563eb;
        background: #eff6ff;
      }

      @media (max-width: 480px) {
        main {
          margin: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <h1>Shipping Information Form</h1>

      <form id="shipping-form">

        <input type="hidden" name="lead_source" value="Website - Shipping Page" />

        <h3>Company Size</h3>
        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="company_size" value="1–50 employees" required />
            <span>1–50 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="50–200 employees" />
            <span>50–200 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="200–500 employees" />
            <span>200–500 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="500+ employees" />
            <span>500+ employees</span>
          </label>
        </div>

        <h3>Urgency</h3>
        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="urgency" value="Immediate (0–7 days)" required />
            <span>Immediate (0–7 days)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="urgency" value="Short-term (1–4 weeks)" />
            <span>Short-term (1–4 weeks)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="urgency" value="Ongoing / Planning" />
            <span>Ongoing / Planning</span>
          </label>
        </div>

        <h3>Equipment</h3>
        <div class="card-group">
          <label class="card-option">
            <input type="checkbox" name="equipment" value="Dry Van" />
            <span>Dry Van</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Reefer" />
            <span>Reefer</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Flatbed" />
            <span>Flatbed</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Specialized / Other" />
            <span>Specialized / Other</span>
          </label>
        </div>

        <h3>Notes</h3>
        <textarea name="notes"></textarea>

        <button type="submit">Submit</button>
      </form>

      <script>
        const form = document.getElementById("shipping-form");

        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          const formData = new FormData(form);

          try {
            await fetch("https://formspree.io/f/maqvnaja", {
              method: "POST",
              body: formData,
              headers: { Accept: "application/json" }
            });
          } catch (err) {}

          window.location.href = "https://bflopp.com/thank-you";
        });
      </script>

    </main>

    <Footer />
  </body>
</html>