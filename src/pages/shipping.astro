---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      /* =========================
         BASE MOBILE STABILITY FIX
      ========================== */

      html, body {
        width: 100%;
        overflow-x: hidden;
        -webkit-text-size-adjust: 100%;
        height: 100%;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        background: #f9fafb;
        color: #333;
        line-height: 1.6;
      }

      /* Prevent Safari viewport jump issues */
      body {
        min-height: -webkit-fill-available;
      }

      /* =========================
         HEADER SAFETY FIX
      ========================== */

      header {
        max-width: 100%;
        overflow-x: hidden;
      }

      header * {
        min-width: 0;
      }

      /* =========================
         MAIN LAYOUT
      ========================== */

      main {
        width: 100%;
        max-width: 720px;
        margin: 2rem auto;
        padding: 1rem;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        overflow-x: hidden;
      }

      h1 {
        text-align: center;
        color: #111827;
      }

      h2, h3 {
        color: #111827;
        margin-top: 1.5em;
      }

      p.lead {
        text-align: center;
        color: #6b7280;
      }

      /* =========================
         FORM STABILITY
      ========================== */

      form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
        max-width: 100%;
        padding-bottom: 2rem;
      }

      label {
        font-weight: 600;
        color: #374151;
      }

      input,
      select,
      textarea {
        padding: 0.8em 1em;
        border: 1.5px solid #d1d5db;
        border-radius: 8px;
        font-size: 16px; /* IMPORTANT: prevents iOS zoom */
        width: 100%;
        max-width: 100%;
      }

      textarea {
        min-height: 100px;
      }

      button {
        width: 180px;
        align-self: center;
        padding: 0.75em 1.2em;
        border: none;
        background: #2563eb;
        color: white;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
      }

      button:hover {
        background: #1e40af;
      }

      /* =========================
         iPHONE KEYBOARD FIX
      ========================== */

      @supports (-webkit-touch-callout: none) {
        body {
          min-height: -webkit-fill-available;
        }

        main {
          /* prevents layout jump when keyboard opens */
          transform: translateZ(0);
        }
      }

      /* =========================
         MOBILE OPTIMIZATION
      ========================== */

      @media (max-width: 480px) {
        main {
          margin: 1rem 0.75rem;
          padding: 1rem;
        }

        button {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <h2>Shipping Information Form</h2>

      <h2>🧑‍🚀 Free Freight Cost Review</h2>

      <p class="lead">
        Most shippers overpay 8–22% on full truckload freight.<br />
        Submit your information for a no-obligation review.
      </p>

      <p class="lead">
        We’ll connect you with potential savings opportunities if applicable.
      </p>

      <!-- FORM -->
      <form id="shipping-form">

        <input type="hidden" name="lead_source" value="Website - Shipping Page" />

        <h3>Company Information</h3>

        <label>Company Name</label>
        <input type="text" name="company" required />

        <label>Contact Name</label>
        <input type="text" name="contact" required />

        <label>Email</label>
        <input type="email" name="email" required />

        <label>Industry</label>
        <input type="text" name="industry" />

        <label>Company Size</label>
        <select name="company_size">
          <option>1-50 employees</option>
          <option>50-200 employees</option>
          <option>200-500 employees</option>
          <option>500+</option>
        </select>

        <h3>Freight Profile</h3>

        <label>Monthly Freight Spend</label>
        <select name="monthly_spend" required>
          <option>$0–$10k</option>
          <option>$10k–$50k</option>
          <option>$50k–$250k</option>
          <option>$250k+</option>
        </select>

        <label>Loads Per Month</label>
        <input type="text" name="loads_per_month" />

        <label>Equipment Type</label>
        <select name="equipment">
          <option>Dry Van</option>
          <option>Reefer</option>
          <option>Flatbed</option>
          <option>Mixed</option>
        </select>

        <label>Main Shipping Lanes</label>
        <textarea name="lanes"></textarea>

        <h3>Cost Optimization</h3>

        <label>Biggest Shipping Challenge</label>
        <textarea name="challenge"></textarea>

        <label>
          <input type="checkbox" name="audit_interest" required />
          Yes, I would like a freight cost review
        </label>

        <button type="submit">Request Review</button>
      </form>

      <!-- SUBMIT + RELIABLE REDIRECT -->
      <script>
        const form = document.getElementById("shipping-form");

        form.addEventListener("submit", async function (e) {
          e.preventDefault();

          const formData = new FormData(form);

          try {
            await fetch("https://formspree.io/f/maqvnaja", {
              method: "POST",
              body: formData,
              headers: {
                Accept: "application/json"
              }
            });
          } catch (err) {
            // ignore errors but still redirect
          }

          window.location.href = "https://bflopp.com/thank-you";
        });
      </script>

    </main>

    <Footer />
  </body>
</html>
