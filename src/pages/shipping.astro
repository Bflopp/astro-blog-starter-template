---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/BlogPost.astro';
---
<Header />
<Layout title="Shipping Information" description="Submit shipping details">
  <<html lang="en">
  <head>
    <title>Shipping Information</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        background: white;
        color: rgb(var(--gray-dark, 30, 30, 30));
      }
      main {
        width: calc(100% - 2em);
        max-width: 720px;
        margin: 2em auto;
        padding: 1em;
      }
      h1 {
        text-align: center;
        margin-bottom: 1em;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1em;
      }
      label {
        font-weight: 600;
        margin-bottom: 0.25em;
      }
      input[type="text"],
      input[type="email"],
      textarea {
        padding: 0.5em;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        resize: vertical;
        width: 100%;
        box-sizing: border-box;
      }
      textarea {
        min-height: 100px;
      }
      button {
        width: 100px;
        align-self: center;
        padding: 0.5em 1em;
        border: none;
        background-color: var(--accent, #007acc);
        color: white;
        font-weight: 700;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.3s ease;
      }
      button:hover {
        background-color: #005fa3;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Shipping Information Form</h1>
      <form action="https://formspree.io/f/your-form-id" method="POST">
        <label for="company">Company Name:</label>
        <input type="text" id="company" name="company" required />
        <label for="contact">Contact Person:</label>
        <input type="text" id="contact" name="contact" required />
        <label for="email">Contact Email:</label>
        <input type="email" id="email" name="email" required />
        <label for="address">Shipping Address:</label>
        <textarea id="address" name="address" required></textarea>
        <label for="shippingDetails">Shipping Details:</label>
        <textarea id="shippingDetails" name="shippingDetails" required></textarea>
        <button type="submit">Send</button>
      </form>
    </main>
  </body>
</html>
>
</Layout>
<Footer />

