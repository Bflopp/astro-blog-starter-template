---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        background: #f9fafb;
        color: #111827;
      }

      main {
        max-width: 720px;
        margin: 2rem auto;
        padding: 1rem;
        background: white;
        border-radius: 12px;
      }

      h1 {
        font-size: 1.3rem;
        text-align: center;
      }

      h3 {
        margin-top: 1.5rem;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      input, textarea {
        width: 100%;
        padding: 0.8rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 16px;
      }

      textarea {
        min-height: 90px;
      }

      label {
        font-weight: 600;
      }

      button {
        width: 100%;
        padding: 0.9rem;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 700;
      }

      /* SIMPLE CARD STYLE (NO FLEX TRICKS) */
      .option {
        display: block;
        padding: 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        margin-bottom