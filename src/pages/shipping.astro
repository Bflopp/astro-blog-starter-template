---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        overflow-x: hidden;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        background: #f9fafb;
        color: #333;
        line-height: 1.6;
      }

      main {
        width: 100%;
        max-width: 720px;
        margin: 2rem auto;
        padding: 1rem;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
      }

      h1 {
        text-align: center;
        color: #111827;
        font-size: 1.4rem;
        margin-bottom: 0.75rem;
      }

      h2, h3 {
        color: #111827;
        margin-top: 1.5em;
      }

      p.lead {
        text-align: center;
        color: #6b7280;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
      }

      label {
        font-weight: 600;
        color: #374151;
      }

      input,
      textarea {
        padding: 0.8em 1em;
        border: 1.5px solid #d1d5db;
        border-radius: 8px;
        font-size: 16px;
        width: 100%;
      }

      textarea {
        min-height: 100px;
      }

      button {
        width: 180px;
        align-self: center;
        padding: 0.75em 1.2em;
        border: none;
        background: #2563eb;
        color: white;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
      }

      button:hover {
        background: #1e40af;
      }

      /* =========================
         TAP CARD SYSTEM
      ========================== */

      .card-group {
        display: grid;
        gap: 0.75rem;
      }

      .card-option {
        border: 1.5px solid #d1d5db;
        border-radius: 12px;
        padding: 0.9rem 1rem;
        cursor: pointer;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        background: #fff;
        transition: all 0.2s ease;
        width: 100%;
      }

      .card-option:hover {
        border-color: #2563eb;
        box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
      }

      .card-option input {
        margin-top: 0.15rem;
        transform: scale(1.2);
        flex-shrink: 0;
      }

      .card-option span {
        white-space: normal;
        word-break: break-word;
        line-height: 1.3;
      }

      .card-option:has(input:checked) {
        border-color: #2563eb;
        background: #eff6ff;
      }

      @media (max-width: 480px) {
        main {
          margin: 1rem 0.75rem;
          padding: 1rem;
        }

        button {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <h1>Shipping Information Form</h1>

      <h2>🚛 Freight Connection Request</h2>

      <p class="lead">
        Bflopp connects shippers with qualified freight brokers based on operational patterns and routing needs.
      </p>

      <form id="shipping-form">

        <input type="hidden" name="lead_source" value="Website - Shipping Page" />
        <input type="hidden" name="lead_type" value="broker_match_request" />

        <!-- COMPANY INFO -->
        <h3>Company Information</h3>

        <label>Company Name</label>
        <input type="text" name="company" required />

        <label>Contact Name</label>
        <input type="text" name="contact" required />

        <label>Email</label>
        <input type="email" name="email" required />

        <label>Industry</label>
        <input type="text" name="industry" />

        <!-- COMPANY SIZE -->
        <h3>Company Size</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="company_size" value="1–50 employees" required />
            <span>1–50 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="50–200 employees" />
            <span>50–200 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="200–500 employees" />
            <span>200–500 employees</span>
          </label>

          <label class="card-option">
            <input type="radio" name="company_size" value="500+ employees" />
            <span>500+ employees</span>
          </label>
        </div>

        <!-- FREQUENCY -->
        <h3>Shipment Frequency</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="shipment_frequency" value="1–5/month" required />
            <span>1–5 shipments per month</span>
          </label>

          <label class="card-option">
            <input type="radio" name="shipment_frequency" value="6–20/month" />
            <span>6–20 shipments per month</span>
          </label>

          <label class="card-option">
            <input type="radio" name="shipment_frequency" value="20–100/month" />
            <span>20–100 shipments per month</span>
          </label>

          <label class="card-option">
            <input type="radio" name="shipment_frequency" value="100+/month" />
            <span>100+ shipments per month</span>
          </label>
        </div>

        <!-- URGENCY -->
        <h3>Shipping Urgency</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="urgency" value="Immediate (0–7 days)" required />
            <span>⚡ Immediate (0–7 days)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="urgency" value="Short-term (1–4 weeks)" />
            <span>📦 Short-term (1–4 weeks)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="urgency" value="Ongoing / Planning" />
            <span>📅 Ongoing / Planning</span>
          </label>
        </div>

        <!-- SHIPMENT TYPE -->
        <h3>Shipment Type</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="radio" name="shipment_type" value="FTL" required />
            <span>Full Truckload (FTL)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="shipment_type" value="LTL" />
            <span>Less-than-Truckload (LTL)</span>
          </label>

          <label class="card-option">
            <input type="radio" name="shipment_type" value="Mixed" />
            <span>Mixed</span>
          </label>
        </div>

        <!-- EQUIPMENT -->
        <h3>Equipment Needs</h3>

        <div class="card-group">
          <label class="card-option">
            <input type="checkbox" name="equipment" value="Dry Van" />
            <span>Dry Van</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Reefer" />
            <span>Reefer</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Flatbed" />
            <span>Flatbed</span>
          </label>

          <label class="card-option">
            <input type="checkbox" name="equipment" value="Specialized / Other" />
            <span>Specialized / Other</span>
          </label>
        </div>

        <!-- ROUTES -->
        <h3>Main Shipping Routes</h3>
        <textarea name="lanes"></textarea>

        <h3>Notes</h3>
        <textarea name="challenge"></textarea>

        <label>
          <input type="checkbox" name="audit_interest" required />
          Yes, I would like assistance with freight matching
        </label>

        <button type="submit">Request Review</button>
      </form>

      <script>
        const form = document.getElementById("shipping-form");

        form.addEventListener("submit", async function (e) {
          e.preventDefault();

          const formData = new FormData(form);

          try {
            await fetch("https://formspree.io/f/maqvnaja", {
              method: "POST",
              body: formData,
              headers: { Accept: "application/json" }
            });
          } catch (err) {}

          window.location.href = "https://bflopp.com/thank-you";
        });
      </script>

    </main>

    <Footer />
  </body>
</html>