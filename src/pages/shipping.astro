---
// src/pages/shipping.astro
---

<html lang="en">
  <head>
    <title>Shipping Information</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  </head>
  <body>
    <h1>Shipping Information Form</h1>
    <form
      action="https://formspree.io/f/your-form-id" 
      method="POST"
    >
      <label for="company">Company Name:</label><br/>
      <input type="text" id="company" name="company" required /><br/>

      <label for="contact">Contact Person:</label><br/>
      <input type="text" id="contact" name="contact" required /><br/>

      <label for="email">Contact Email:</label><br/>
      <input type="email" id="email" name="email" required /><br/>

      <label for="address">Shipping Address:</label><br/>
      <textarea id="address" name="address" required></textarea><br/>

      <label for="shippingDetails">Shipping Details:</label><br/>
      <textarea id="shippingDetails" name="shippingDetails" required></textarea><br/>

      <button type="submit">Send</button>
    </form>
  </body>
</html>
