---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        background: white;
        color: rgb(var(--gray-dark, 30, 30, 30));
      }
      main {
        width: calc(100% - 2em);
        max-width: 720px;
        margin: 2em auto;
        padding: 1em;
      }
      h1 {
        text-align: center;
        margin-bottom: 1em;
      }
      form {
        display: flex;
        flex-direction: column;
        gap: 1em;
      }
      label {
        font-weight: 600;
        margin-bottom: 0.25em;
      }
      input[type="text"],
      input[type="email"],
      textarea {
        padding: 0.5em;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        resize: vertical;
        width: 100%;
        box-sizing: border-box;
      }
      textarea {
        min-height: 100px;
      }
      button {
        width: 100px;
        align-self: center;
        padding: 0.5em 1em;
        border: none;
        background-color: var(--accent, #007acc);
        color: white;
        font-weight: 700;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.3s ease;
      }
      button:hover {
        background-color: #005fa3;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Shipping Information Form</h1>
      <h1>Free Freight Cost Review</h1>
<p style="text-align:center;">

Most shippers overpay 8–22% on full truckload freight.

Submit your information for a no-obligation cost review.

</p>
<form action="https://formspree.io/f/your-form-id" method="POST">

    <!-- Hidden Lead Tracking -->

  <input type="hidden" name="lead_source" value="Website - Shipping Page" />

  <!-- COMPANY INFO -->

  <h3>Company Information</h3>

  <label>Company Name</label>

  <input type="text" name="company" required />

  <label>Contact Name</label>

  <input type="text" name="contact" required />

  <label>Email</label>

  <input type="email" name="email" required />

  <label>Industry</label>

  <input type="text" name="industry" placeholder="Manufacturing, Food, Retail, Construction..." />

  <label>Company Size</label>

  <select name="company_size">

    <option>1-50 employees</option>

    <option>50-200 employees</option>

    <option>200-500 employees</option>

    <option>500+</option>

  </select>

  <h3>Freight Profile</h3>

  <label>Monthly Freight Spend</label>

  <select name="monthly_spend" required>

    <option>$0–$10k</option>

    <option>$10k–$50k</option>

    <option>$50k–$250k</option>

    <option>$250k+</option>

  </select>

  <label>Approx Loads Per Month</label>

  <input type="text" name="loads_per_month" />

  <label>Equipment Type</label>

  <select name="equipment">

    <option>Dry Van</option>

    <option>Reefer</option>

    <option>Flatbed</option>

    <option>Mixed</option>

  </select>

  <label>Main Shipping Lanes</label>

  <textarea name="lanes" placeholder="Example: Portland OR → Dallas TX"></textarea>

  <h3>Cost Optimization</h3>

  <label>Biggest Shipping Challenge</label>

  <textarea name="challenge"></textarea>

  <label>

    <input type="checkbox" name="audit_interest" required />

    Yes, I would like a free freight cost analysis.

  </label>

  <button type="submit">Request Review</button>

</form>
    </main>
    <Footer />
  </body>
</html>
