---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title="ROOST — Dirt Bike Trivia"
      description="ROOST is a dirt-bike themed rarity trivia game. Seven timed prompts, obscure answers ride farther — how far can your answers take you?"
    />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        overflow-x: hidden;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        background: #f9fafb;
        color: #333;
        line-height: 1.6;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
        width: 100%;
        max-width: 960px;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      .page-head {
        text-align: center;
        margin-bottom: 1.25rem;
      }

      .page-head h1 {
        margin: 0 0 0.25rem;
        color: #111827;
        letter-spacing: 0.08em;
      }

      .page-head p {
        margin: 0;
        color: #6b7280;
      }

      .game-frame {
        width: 100%;
        height: 860px;
        min-height: 78vh;
        border: 0;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        background: #0d1526;
        display: block;
      }

      @media (max-width: 480px) {
        main { margin: 1rem auto; }
        .game-frame { height: 92vh; border-radius: 0; }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <div class="page-head">
        <h1>ROOST</h1>
        <p>Seven timed prompts. Obscure answers ride farther. How far can yours take you?</p>
      </div>
      <iframe
        class="game-frame"
        src="/roost-game/"
        title="ROOST dirt bike trivia game"
        allow="clipboard-write"
        loading="lazy"
      ></iframe>
    </main>
    <Footer />
  </body>
</html>
